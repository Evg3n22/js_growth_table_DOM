"use strict";
// write code here
var container = document.querySelector(".container");
var tbody = document.querySelector("tbody");
var btns = document.querySelectorAll(".button");
container.addEventListener("click", function(e) {
    var currColumns = Array.from(tbody.querySelectorAll("tr:nth-child(1) td")).length;
    // Add rows
    if (e.target === btns[0]) {
        var tr = document.createElement("tr");
        for(var i = 0; i < currColumns; i++){
            var td = document.createElement("td");
            tr.appendChild(td);
        }
        tbody.appendChild(tr);
    }
    // Remove rows
    if (e.target === btns[1]) {
        var tr1 = tbody.querySelector("tr:last-child");
        tbody.removeChild(tr1);
    }
    // Add columns
    if (e.target === btns[2]) {
        var rows = Array.from(tbody.querySelectorAll("tr"));
        rows.forEach(function(r) {
            var td = document.createElement("td");
            r.appendChild(td);
        });
    }
    // Remove columns
    if (e.target === btns[3]) {
        var rows1 = Array.from(tbody.querySelectorAll("tr"));
        rows1.forEach(function(r) {
            var td = r.querySelector("td:last-child");
            r.removeChild(td);
        });
    }
});

